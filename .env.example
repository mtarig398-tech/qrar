# Copy this file to .env and fill in the values for your machine.

# --- Power BI MCP server (microsoft/powerbi-modeling-mcp) ---
# Absolute path to the powerbi-modeling-mcp executable. See README.md for
# how to obtain it (VSIX download, or "npx" if you have Node.js).
POWERBI_MCP_PATH=C:\path\to\powerbi-modeling-mcp.exe
MCP_REQUEST_TIMEOUT=60
# --readonly keeps the AI from modifying the semantic model. Remove it only
# if you intentionally want write access.
MCP_LAUNCH_ARGS=--start,--readonly
# Tool names/arguments as reported by tools/list; use the app's sidebar
# "MCP tools" debug panel to confirm these against your installed version.
MCP_DAX_TOOL=dax_query_operations
MCP_DAX_ARGUMENTS_TEMPLATE={"operation": "run", "query": __DAX_QUERY__}
MCP_SCHEMA_TOOL=model_operations
MCP_SCHEMA_ARGUMENTS={"operation": "list"}

# --- Ollama (local, free) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# --- OpenAI (optional cloud fallback) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Gemini (optional cloud fallback) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Smart Fallback order, comma separated, tried left to right.
PROVIDER_ORDER=ollama,openai,gemini
# Local CPU-only Ollama can take over a minute, especially on the first
# request after startup while the model loads into RAM.
AI_REQUEST_TIMEOUT=180
