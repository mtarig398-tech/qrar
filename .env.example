# Copy this file to .env and fill in the values for your machine.

# --- Power BI MCP server ---
# Absolute path to the powerbi-modeling-mcp executable.
POWERBI_MCP_PATH=C:\path\to\powerbi-modeling-mcp.exe
MCP_REQUEST_TIMEOUT=60
# Tool names as reported by the server's tools/list; adjust if different.
MCP_SCHEMA_TOOL=get_model_schema
MCP_DAX_TOOL=execute_dax_query

# --- Ollama (local, free) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# --- OpenAI (optional cloud fallback) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Gemini (optional cloud fallback) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Smart Fallback order, comma separated, tried left to right.
PROVIDER_ORDER=ollama,openai,gemini
AI_REQUEST_TIMEOUT=45
